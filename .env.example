# Database Backup to S3 / Dokploy
# Daily cron endpoint: GET /api/cron/database-backup with Authorization: Bearer $CRON_SECRET
CRON_SECRET="change-me-long-random"
DB_BACKUP_S3_PREFIX="database-backups/hero"
PG_DUMP_BIN="/usr/bin/pg_dump"
PSQL_BIN="/usr/bin/psql"
S3_BUCKET_NAME="your-s3-bucket"
S3_REGION="auto"
S3_ENDPOINT="https://your-s3-endpoint"
S3_FORCE_PATH_STYLE="true"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
