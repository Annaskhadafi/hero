# Development Environment Variables
# Copy this file to .env and modify as needed

# Database Configuration
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
# Managed PostgreSQL example:
# DATABASE_URL=postgresql://username:password@host:5432/database_name
DATABASE_URL=postgresql://username:password@host:5432/database_name
POSTGRES_DB=database_name
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Authentication
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth for Better Auth
# Authorized redirect URI example:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3 Uploads
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom S3-compatible endpoint such as R2/MinIO
S3_ENDPOINT=
# Optional: set true for MinIO/path-style buckets
S3_FORCE_PATH_STYLE=false
# Optional: public CDN/base URL for rendered assets
S3_PUBLIC_URL_BASE=
# Optional: prefix folder for uploads (e.g. "upload")
S3_UPLOAD_PREFIX=
