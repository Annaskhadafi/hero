# Development Environment Variables
# Copy this file to .env and modify as needed.

# Database Configuration
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
# Remote DB without SSL:
# DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=disable
# Remote DB with SSL:
# DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require
DATABASE_URL=postgresql://username:password@host:5432/database_name
POSTGRES_DB=database_name
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Authentication
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000/api/auth"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000/api/auth"

UPLOAD_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://is3.cloudhost.id
OBJECT_STORAGE_BUCKET=your-bucket
OBJECT_STORAGE_PREFIX=upload
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-key

CRON_SECRET=your-cron-secret
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr

# Get API key: https://openrouter.ai/keys
OLLAMA_URL="https://openrouter.ai/api/v1/chat/completions"
OLLAMA_MODEL="xiaomi/mimo-v2.5"
OLLAMA_API_KEY="your-openrouter-api-key"

# LMS Integration
LMS_SITE_URL=https://chitralearning.com
LMS_JWT_SECRET=your_sso_shared_jwt_secret_key_change_me

# LMS Database Configuration (Hostinger WordPress LMS)
LMS_DB_HOST=153.92.15.50
LMS_DB_PORT=3306
LMS_DB_USER=u234341468_jh8R1
