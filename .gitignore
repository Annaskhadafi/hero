# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed, allow .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# face-api.js model files must ship with mobile face recognition
!public/models/*-shard*
!public/models/*.bin

# database dumps (may contain credentials/data)
*.sql
!drizzle/*.sql

# local agent/generated artifacts
*.backup
.claude/worktrees/
graphify-out/
.code-review-graph/

# local scratch/inspection files
scratch/

# local utility scripts (not deployed)
scripts/add_employee_columns.ts
scripts/deduplicate-sites.ts
scripts/inspect-sections.ts
scripts/sync-existing-org-nodes.ts
scripts/sync-new-karyawan.ts

# excel/data files
*.xlsx
*.xls
tmp_*.txt
test.ts
