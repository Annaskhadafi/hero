{
  "name": "hero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbopack": "next dev --turbopack",
    "build": "node scripts/download-face-models.mjs && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "jest",
    "test:playwright": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "qa:attendance-import": "tsx scripts/qa-attendance-import.ts",
    "check:attendance-db": "tsx scripts/check-attendance-db-drift.ts",
    "audit:master-data-sync": "tsx scripts/audit-master-data-sync.ts",
    "check:focused": "npm run qa:attendance-import && npm run check:attendance-db && npm test -- --runInBand tests/scheduling-timesheet.test.ts && npm run type-check && npm run lint",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/db-push.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "db:reorganize": "tsx scripts/reorganize-menus-grouped.ts",
    "db:pull": "drizzle-kit pull",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:import:data-hero": "tsx scripts/import-data-hero.ts",
    "db:import:safety-dashboard": "tsx scripts/import-safety-dashboard.ts",
    "db:import:hiradc": "tsx scripts/import-hiradc.ts",
    "db:seed:recruitment-templates": "tsx scripts/seed-recruitment-templates.ts",
    "db:seed:tire-presets": "tsx scripts/seed-tire-presets.ts",
    "db:create:tire-tables": "tsx scripts/create-tire-pattern-tables.ts",
    "db:migrate:hse": "tsx scratch/migrate-hse-inventories.ts",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down postgres",
    "db:dev": "docker compose --profile dev up postgres-dev -d",
    "db:dev-down": "docker compose --profile dev down postgres-dev",
    "db:reset": "drizzle-kit drop && drizzle-kit push",
    "docker:build": "docker build -t codeguide-starter-fullstack .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test"
  },
